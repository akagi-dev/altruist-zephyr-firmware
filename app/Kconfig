menu "Altruist Zephyr Firmware"

config ALTRUIST_BOOT_MESSAGE
	string "Boot message"
	default "Altruist Zephyr bootstrap ready"
	help
	  Message printed during boot.

menu "WiFi and provisioning"

config ALTRUIST_WIFI_MANAGER
	bool "Enable Altruist WiFi manager"
	default n
	help
	  Enables WiFi station lifecycle handling, reconnect policy and
	  provisioning entrypoints.

config ALTRUIST_WIFI_RECONNECT_INITIAL_BACKOFF_MS
	int "Initial reconnect backoff (ms)"
	depends on ALTRUIST_WIFI_MANAGER
	default 1000
	range 100 60000
	help
	  Delay used for the first reconnect retry after disconnect.
	  Valid range is 100 ms to 60 s.

config ALTRUIST_WIFI_RECONNECT_MAX_BACKOFF_MS
	int "Maximum reconnect backoff (ms)"
	depends on ALTRUIST_WIFI_MANAGER
	default 30000
	range 1000 600000
	help
	  Upper bound used by exponential reconnect backoff.
	  Valid range is 1 s to 10 min.

config ALTRUIST_WIFI_MANAGER_TEST_SEAMS
	bool
	depends on ALTRUIST_WIFI_MANAGER
	default n
	help
	  Exposes deterministic time/event hooks used by unit tests.

endmenu

source "Kconfig.variants"

endmenu
