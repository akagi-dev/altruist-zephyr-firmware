menu "Altruist Zephyr Firmware"

config ALTRUIST_CONFIG
	bool "Enable Altruist config subsystem"
	default y
	select SETTINGS
	help
	  Enables persistent Altruist settings/config management.

config ALTRUIST_BOOT_MESSAGE
	string "Boot message"
	default "Altruist Zephyr bootstrap ready"
	help
	  Message printed during boot.

config ALTRUIST_IDENTITY
	bool "Enable Altruist device identity/keystore"
	default y
	select SETTINGS
	select CSPRNG_NEEDED
	select MBEDTLS
	select MBEDTLS_PSA_CRYPTO_C
	help
	  Enables ED25519 device identity management using Zephyr settings storage.
	  Ed25519 (RFC 8032) signing/verification is provided by PSA Crypto API,
	  and key material is generated from the PSA cryptographic subsystem.

source "Kconfig.variants"

endmenu
